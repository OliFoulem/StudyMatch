<nav class="steps" aria-label="Progression du jumelage">
@for (var i = 1; i <= 3; i++)
{
    <span class="step @(i == Current ? "active" : i < Current ? "complete" : "")" aria-current="@(i == Current ? "step" : null)">@i. @(i == 1 ? "Cours" : i == 2 ? "Disponibilités" : "Confirmation")</span>
}
</nav>
@code { [Parameter] public int Current { get; set; } }
